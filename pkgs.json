{
    "code": {
        "container": "ghcr.io/alessandroruggiero/dp-custom-ale/code:main",
        "app": true,
        "configmounts": {
            "vscodeconfig": "/home/penguin/.vscode-container/",
            "config": "/home/penguin/.config/",
            "cache": "/home/penguin/.cache/",
            "dot_claude": "/home/penguin/.claude/",
            "dot_claude_file": {
                "path": "/home/penguin/.claude.json",
                "type": "file"
            }
        },
        "extra_run_args": [
            {
                "args": [
                    "--security-opt",
                    "no-new-privileges",
                    "--cap-drop=ALL",
                    "--cap-add=CHOWN",
                    "--cap-add=DAC_OVERRIDE",
                    "--cap-add=SETUID",
                    "--cap-add=SETGID"
                ],
                "description": "Tightens the container beyond the default: drops every Linux capability except the four the entrypoint needs to remap the penguin user to your UID/GID and drop privileges, and blocks privilege escalation. This strengthens isolation rather than weakening it"
            },
            {
                "args": [
                    "--pids-limit=4092",
                    "--memory=4g"
                ],
                "description": "Caps runaway extensions or language servers at 4GB of RAM and 4092 processes so they cannot exhaust your machine"
            }
        ]
    },
    "vs-code": {
